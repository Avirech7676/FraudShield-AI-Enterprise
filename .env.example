# ==========================================================================
# BACKEND environment variables (FastAPI) - copy to ".env" for local dev.
# On Render, set these in the dashboard (do NOT commit real secrets).
# ==========================================================================

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
# For MongoDB Atlas use the SRV string, e.g.:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=FraudShieldDB

# --- Auth (JWT) ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS: your deployed frontend URL(s), comma separated, NO trailing slash ---
FRONTEND_ORIGINS=http://localhost:5173

# --- AI / LLM (optional; app runs in simulation mode if unset) ---
GROQ_API_KEY=

# --- Model / paths ---
MODEL_DIRECTORY=models
MODEL_VERSION=2.0
DEFAULT_MODEL_VERSION=2.0
LOG_DIRECTORY=logs
REPORT_DIRECTORY=reports

# --- API ---
API_VERSION=v2
RATE_LIMIT_PER_MINUTE=60
