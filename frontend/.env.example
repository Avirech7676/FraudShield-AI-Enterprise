# ==========================================================================
# FRONTEND environment variables (Vite).
# Copy to "frontend/.env" for local dev. On Vercel, set these in
# Project Settings -> Environment Variables (Vite only exposes VITE_* vars,
# and they are baked in AT BUILD TIME, so redeploy after changing them).
# ==========================================================================

# Base URL of your FastAPI backend (NO trailing slash).
# Local dev:
VITE_API_BASE_URL=http://127.0.0.1:8000
# Production example:
# VITE_API_BASE_URL=https://fraudshield-api.onrender.com

# Clerk publishable key (starts with pk_test_ or pk_live_).
# Get it from https://dashboard.clerk.com -> your app -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
